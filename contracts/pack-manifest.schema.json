{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PackManifest",
  "description": "Metadata stored as manifest.json; list IDs are not paths.",
  "type": "object",
  "required": [
    "id",
    "license",
    "lists",
    "name",
    "schemaVersion",
    "visibility"
  ],
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "license": {
      "type": "string"
    },
    "lists": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1.0,
      "minimum": 1.0
    },
    "visibility": {
      "$ref": "#/definitions/Visibility"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Visibility": {
      "description": "Publication boundary shared by exercises, lists and packs.",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    }
  }
}
