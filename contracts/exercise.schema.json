{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exercise",
  "description": "Canonical revision of an exercise.",
  "type": "object",
  "required": [
    "id",
    "locale",
    "parts",
    "revision",
    "schemaVersion",
    "skills",
    "source",
    "statement",
    "title",
    "visibility"
  ],
  "properties": {
    "assets": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Asset"
      }
    },
    "difficulty": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "maximum": 5.0,
      "minimum": 1.0
    },
    "estimatedMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1.0
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "locale": {
      "type": "string"
    },
    "params": {
      "type": "null"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Part"
      },
      "minItems": 1
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Reference"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1.0
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1.0,
      "minimum": 1.0
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source": {
      "$ref": "#/definitions/Source"
    },
    "statement": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "visibility": {
      "$ref": "#/definitions/Visibility"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AnswerOption": {
      "description": "Stable identity and display text of an objective option.",
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AnswerSpec": {
      "description": "All nine F1 answer kinds. `code` and `sql` are intentionally unsupported.",
      "oneOf": [
        {
          "description": "Constant expression and optional numeric comparison metadata.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "tolerance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Tolerance"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "numeric"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Expected expression and deterministic sampling settings.",
          "type": "object",
          "required": [
            "expected",
            "type",
            "variables"
          ],
          "properties": {
            "domain": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "form": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ExpressionForm"
                },
                {
                  "type": "null"
                }
              ]
            },
            "samples": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 12.0
            },
            "tolerance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Tolerance"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "expression"
              ]
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Equation represented as `lhs = rhs`.",
          "type": "object",
          "required": [
            "expected",
            "type",
            "variables"
          ],
          "properties": {
            "domain": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "samples": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 12.0
            },
            "tolerance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Tolerance"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "equation"
              ]
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Unordered collection; `ordered` must be false.",
          "type": "object",
          "required": [
            "ordered",
            "type",
            "values"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "ordered": {
              "type": "boolean",
              "enum": [
                false
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "set"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ScalarAnswerSpec"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Ordered, nonempty collection.",
          "type": "object",
          "required": [
            "type",
            "values"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "tuple"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ScalarAnswerSpec"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Nonempty rectangular matrix of scalar specifications.",
          "type": "object",
          "required": [
            "rows",
            "type"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ScalarAnswerSpec"
                },
                "minItems": 1
              },
              "minItems": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "matrix"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Single or multiple choice specification.",
          "type": "object",
          "required": [
            "correct",
            "multiple",
            "options",
            "type"
          ],
          "properties": {
            "correct": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "multiple": {
              "type": "boolean"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AnswerOption"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "choice"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Matching specification with stable option identities.",
          "type": "object",
          "required": [
            "left",
            "pairs",
            "right",
            "type"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "left": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AnswerOption"
              }
            },
            "pairs": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "partialCredit": {
              "default": false,
              "type": "boolean"
            },
            "right": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AnswerOption"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "matching"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Manual comparison with a rubric, never automatic grading.",
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "rubric": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "self_graded"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Asset": {
      "description": "Asset location inside a pack. Sanitization occurs at import/render time.",
      "type": "object",
      "required": [
        "alt",
        "id",
        "path"
      ],
      "properties": {
        "alt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EngineRequest": {
      "description": "Request to the existing engine; not evidence of answer correctness.",
      "type": "object",
      "required": [
        "command",
        "request"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "request": true
      },
      "additionalProperties": false
    },
    "ExpressionForm": {
      "description": "Required structural expression form.",
      "type": "string",
      "enum": [
        "factored",
        "expanded",
        "no_negative_exponents"
      ]
    },
    "Feedback": {
      "description": "Feedback for a predictable incorrect answer.",
      "type": "object",
      "required": [
        "matches",
        "message"
      ],
      "properties": {
        "matches": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Part": {
      "description": "A stable exercise part; verification fields arrive in F1.4.",
      "type": "object",
      "required": [
        "answer",
        "label",
        "prompt"
      ],
      "properties": {
        "answer": {
          "$ref": "#/definitions/AnswerSpec"
        },
        "hints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "points": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "prompt": {
          "type": "string"
        },
        "solution": {
          "anyOf": [
            {
              "$ref": "#/definitions/Solution"
            },
            {
              "type": "null"
            }
          ]
        },
        "viz": {
          "anyOf": [
            {
              "$ref": "#/definitions/Visualization"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Reference": {
      "description": "External study reference; material links are reserved for F2 and must remain null.",
      "type": "object",
      "required": [
        "license",
        "title",
        "type"
      ],
      "properties": {
        "arxiv": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "isbn": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "material": {
          "type": "null"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/definitions/ReferenceType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[hH][tT][tT][pP][sS]?://"
        }
      },
      "additionalProperties": false
    },
    "ReferenceType": {
      "description": "Reference metadata kind; no file attachment is supported.",
      "type": "string",
      "enum": [
        "paper",
        "book",
        "notes",
        "video",
        "webpage"
      ]
    },
    "ScalarAnswerSpec": {
      "description": "Nonrecursive scalar element of a collection (ADR 0016).",
      "oneOf": [
        {
          "description": "Constant expression and optional numeric comparison metadata.",
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "tolerance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Tolerance"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "numeric"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Expected expression and deterministic sampling settings.",
          "type": "object",
          "required": [
            "expected",
            "type",
            "variables"
          ],
          "properties": {
            "domain": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "feedback": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/definitions/Feedback"
              }
            },
            "form": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ExpressionForm"
                },
                {
                  "type": "null"
                }
              ]
            },
            "samples": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 12.0
            },
            "tolerance": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Tolerance"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "expression"
              ]
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Solution": {
      "description": "Optional authored steps or engine-produced explanation.",
      "type": "object",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "$ref": "#/definitions/EngineRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Source": {
      "description": "Content license and attribution metadata.",
      "type": "object",
      "required": [
        "kind",
        "license"
      ],
      "properties": {
        "authors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citation": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/SourceKind"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SourceKind": {
      "description": "Provenance of the exercise text, not of its references.",
      "type": "string",
      "enum": [
        "authored",
        "imported",
        "adapted"
      ]
    },
    "Tolerance": {
      "description": "Absolute and relative comparison tolerances.",
      "type": "object",
      "properties": {
        "abs": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0.0
        },
        "rel": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Visibility": {
      "description": "Publication boundary shared by exercises, lists and packs.",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "Visualization": {
      "description": "Visualization registry key and parameters; registry validation belongs to F1.6.",
      "type": "object",
      "required": [
        "id",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "params": true
      },
      "additionalProperties": false
    }
  }
}
