apps/web/src/lib/wasm/pkg/
crates/mv-wasm/pkg/

# ─── Node / pnpm ─────────────────────────────────────────────────────
# pnpm-lock.yaml IS committed.
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ─── SvelteKit / Vite ────────────────────────────────────────────────
apps/web/.svelte-kit/
apps/web/build/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
.eslintcache

# ─── Tests ───────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
playwright/.cache/

# ─── Tauri ───────────────────────────────────────────────────────────
